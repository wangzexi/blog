---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const outline = headings.filter(({ depth }) => depth === 2 || depth === 3);
---

{outline.length > 0 && (
  <aside class="article-toc" aria-label="文章目录">
    <ol class="article-toc__list">
      {outline.map((heading) => (
        <li class:list={['article-toc__item', `article-toc__item--h${heading.depth}`]}>
          <a class="article-toc__link" href={`#${heading.slug}`} data-target={heading.slug}>
            {heading.text}
          </a>
        </li>
      ))}
    </ol>
  </aside>
)}

<script>
  const headings = [...document.querySelectorAll<HTMLElement>('.markdown-section h2, .markdown-section h3')];
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.article-toc__link')];

  function updateOutline() {
    let active = headings[0]?.id;
    for (const heading of headings) {
      if (heading.getBoundingClientRect().top <= 150) active = heading.id;
    }
    for (const link of links) {
      link.classList.toggle('is-active', link.dataset.target === active);
    }
  }

  if (headings.length > 0) {
    addEventListener('scroll', updateOutline, { passive: true });
    updateOutline();
  }
</script>
