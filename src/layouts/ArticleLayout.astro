---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Mermaid from '../components/Mermaid.astro';
import TableOfContents from '../components/TableOfContents.astro';

interface Props {
  title: string;
  updatedAt: string;
  headings: MarkdownHeading[];
  hasMermaid?: boolean;
}

const { title, updatedAt, headings, hasMermaid = false } = Astro.props;
const updatedDate = updatedAt.slice(0, 10);
const formatDate = (date: string) => {
  const [year, month, day] = date.split('-');
  return `${year} 年 ${Number(month)} 月 ${Number(day)} 日`;
};
---

<BaseLayout title={`${title} · Zexi's Blog`} pageClass="article-page">
  <main class="blog-reading-layout">
    <article class="markdown-section">
      <nav class="article-breadcrumb" aria-label="面包屑导航">
        <a href="/">首页</a>
        <span class="article-breadcrumb__separator" aria-hidden="true">/</span>
        <span class="article-breadcrumb__current" aria-current="page">{title}</span>
      </nav>
      <h1>{title}</h1>
      <div class="article-meta">
        更新于 <time datetime={updatedAt}>{formatDate(updatedDate)}</time>
      </div>
      <slot />
    </article>
    <TableOfContents headings={headings} />
  </main>
  {hasMermaid && <Mermaid />}
</BaseLayout>
